<Window x:Class="Screenrecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Screenrecorder.Resources"
        Title="Screenrecorder" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="8">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="RecordButton" Style="{StaticResource ToolButton}" Click="Record_Click" IsEnabled="False"
                ToolTip="{x:Static res:Strings.HotkeyHint}">
            <StackPanel>
                <TextBlock x:Name="RecordGlyph" Style="{StaticResource Glyph}" Text="&#xE7C8;" Foreground="#E53935" />
                <TextBlock x:Name="RecordText" Text="{x:Static res:Strings.Record}" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="AreaButton" Style="{StaticResource ToolButton}" Click="Area_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                <TextBlock Text="{x:Static res:Strings.Area}" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="CodecsButton" Style="{StaticResource ToolButton}" Click="Codecs_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" />
                <TextBlock Text="{x:Static res:Strings.Codecs}" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="SoundButton" Style="{StaticResource ToolButton}" Click="Sound_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" />
                <TextBlock Text="{x:Static res:Strings.Sound}" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="Open_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                <TextBlock Text="{x:Static res:Strings.Open}" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="MenuButton" Style="{StaticResource ToolButton}" Click="Menu_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE700;" />
                <TextBlock Text="{x:Static res:Strings.Menu}" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
    <!-- Shown while recording: elapsed time and current file size -->
    <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="4,6,4,0" FontSize="15" FontWeight="SemiBold"
               HorizontalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" />
    </StackPanel>
</Window>
