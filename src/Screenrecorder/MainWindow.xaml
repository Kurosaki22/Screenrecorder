<Window x:Class="Screenrecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Screenrecorder.Resources"
        xmlns:local="clr-namespace:Screenrecorder"
        Title="Screenrecorder" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Top-aligned so icons line up whether or not a hotkey hint is shown -->
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="4,12,4,4" />
            <Style.Triggers>
                <!-- Fluent draws disabled buttons as a grey box, which reads as "selected"; fade them instead -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Hotkey hint under a button, e.g. "F2" -->
        <Style x:Key="HotkeyHint" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="8">
    <!-- OBS-style audio mixer, opened by the Sound button -->
    <Popup x:Name="MixerPopup" PlacementTarget="{Binding ElementName=SoundButton}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <local:AudioMixer x:Name="Mixer" Margin="0,4,0,0" />
    </Popup>
    <StackPanel Orientation="Horizontal">
        <Button x:Name="RecordButton" Style="{StaticResource ToolButton}" Click="Record_Click" IsEnabled="False">
            <StackPanel>
                <TextBlock x:Name="RecordGlyph" Style="{StaticResource Glyph}" Text="&#xE7C8;" Foreground="#E53935" />
                <TextBlock x:Name="RecordText" Text="{x:Static res:Strings.Record}" Style="{StaticResource Label}" />
                <TextBlock x:Name="RecordHotkey" Style="{StaticResource HotkeyHint}" />
            </StackPanel>
        </Button>
        <Button x:Name="PauseButton" Style="{StaticResource ToolButton}" Click="Pause_Click" IsEnabled="False">
            <StackPanel>
                <TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" />
                <TextBlock x:Name="PauseText" Text="{x:Static res:Strings.Pause}" Style="{StaticResource Label}" />
                <TextBlock x:Name="PauseHotkey" Style="{StaticResource HotkeyHint}" />
            </StackPanel>
        </Button>
        <Button x:Name="ScreenshotButton" Style="{StaticResource ToolButton}" Click="Screenshot_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" />
                <TextBlock Text="{x:Static res:Strings.Screenshot}" Style="{StaticResource Label}" />
                <TextBlock x:Name="ScreenshotHotkey" Style="{StaticResource HotkeyHint}" />
            </StackPanel>
        </Button>
        <Button x:Name="AreaButton" Style="{StaticResource ToolButton}" Click="Area_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                <TextBlock Text="{x:Static res:Strings.Area}" Style="{StaticResource Label}" />
                <TextBlock x:Name="AreaHotkey" Style="{StaticResource HotkeyHint}" />
            </StackPanel>
        </Button>
        <Button x:Name="CodecsButton" Style="{StaticResource ToolButton}" Click="Codecs_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" />
                <TextBlock Text="{x:Static res:Strings.Codecs}" Style="{StaticResource Label}" />
            </StackPanel>
        </Button>
        <Button x:Name="SoundButton" Style="{StaticResource ToolButton}" Click="Sound_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" />
                <TextBlock Text="{x:Static res:Strings.Sound}" Style="{StaticResource Label}" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="Open_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                <TextBlock Text="{x:Static res:Strings.Open}" Style="{StaticResource Label}" />
            </StackPanel>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Width="112" Click="Settings_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                <TextBlock Text="{x:Static res:Strings.Settings}" Style="{StaticResource Label}" />
            </StackPanel>
        </Button>
    </StackPanel>
    </StackPanel>
</Window>
