<Window x:Class="Screenrecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Screenrecorder.Resources"
        xmlns:local="clr-namespace:Screenrecorder"
        Title="Screenrecorder" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource GroundBrush}"
        FontFamily="{StaticResource TextFont}">
    <Window.Resources>
        <Style x:Key="ToolCell" TargetType="Button" BasedOn="{StaticResource Cell}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="80" />
        </Style>
        <Style x:Key="RecordToolCell" TargetType="Button" BasedOn="{StaticResource RecordCell}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="80" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Hotkey hint under a button, e.g. "F2" -->
        <Style x:Key="HotkeyHint" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- OBS-style audio mixer, opened by the Sound button -->
        <Popup x:Name="MixerPopup" PlacementTarget="{Binding ElementName=SoundButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <local:AudioMixer x:Name="Mixer" Margin="0,4,0,0" />
        </Popup>

        <StackPanel Orientation="Horizontal" Margin="8,4,8,8">
            <Button x:Name="RecordButton" Style="{StaticResource RecordToolCell}" Click="Record_Click" IsEnabled="False">
                <StackPanel>
                    <TextBlock x:Name="RecordGlyph" Style="{StaticResource Glyph}" Text="&#xE7C8;" />
                    <TextBlock x:Name="RecordText" Text="{x:Static res:Strings.Record}" Style="{StaticResource Label}" />
                    <TextBlock x:Name="RecordHotkey" Style="{StaticResource HotkeyHint}" />
                </StackPanel>
            </Button>
            <Button x:Name="PauseButton" Style="{StaticResource ToolCell}" Click="Pause_Click" IsEnabled="False">
                <StackPanel>
                    <TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" />
                    <TextBlock x:Name="PauseText" Text="{x:Static res:Strings.Pause}" Style="{StaticResource Label}" />
                    <TextBlock x:Name="PauseHotkey" Style="{StaticResource HotkeyHint}" />
                </StackPanel>
            </Button>
            <Button x:Name="ScreenshotButton" Style="{StaticResource ToolCell}" Click="Screenshot_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" />
                    <TextBlock Text="{x:Static res:Strings.Screenshot}" Style="{StaticResource Label}" />
                    <TextBlock x:Name="ScreenshotHotkey" Style="{StaticResource HotkeyHint}" />
                </StackPanel>
            </Button>
            <Button x:Name="AreaButton" Style="{StaticResource ToolCell}" Click="Area_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                    <TextBlock Text="{x:Static res:Strings.Area}" Style="{StaticResource Label}" />
                    <TextBlock x:Name="AreaHotkey" Style="{StaticResource HotkeyHint}" />
                </StackPanel>
            </Button>
            <Button x:Name="CodecsButton" Style="{StaticResource ToolCell}" Click="Codecs_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" />
                    <TextBlock Text="{x:Static res:Strings.Codecs}" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource HotkeyHint}" Text=" " />
                </StackPanel>
            </Button>
            <Button x:Name="SoundButton" Style="{StaticResource ToolCell}" Click="Sound_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" />
                    <TextBlock Text="{x:Static res:Strings.Sound}" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource HotkeyHint}" Text=" " />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolCell}" Click="Open_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                    <TextBlock Text="{x:Static res:Strings.Open}" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource HotkeyHint}" Text=" " />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource ToolCell}" Width="108" Click="Settings_Click">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                    <TextBlock Text="{x:Static res:Strings.Settings}" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource HotkeyHint}" Text=" " />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Current settings at a glance; RefreshReadout fills it -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceLowBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource InkBrush}">
                <TextBlock Style="{StaticResource Mono}" Margin="0,0,24,0">
                    <Run Text="status" Foreground="{DynamicResource InkMutedBrush}" />
                    <Run x:Name="StateValue" />
                </TextBlock>
                <TextBlock Style="{StaticResource Mono}" Margin="0,0,24,0">
                    <Run Text="video" Foreground="{DynamicResource InkMutedBrush}" />
                    <Run x:Name="VideoValue" />
                </TextBlock>
                <TextBlock Style="{StaticResource Mono}">
                    <Run Text="audio" Foreground="{DynamicResource InkMutedBrush}" />
                    <Run x:Name="SystemValue" Text="{x:Static res:Strings.StatusSystem}" />
                    <Run Text="·" Foreground="{DynamicResource InkMutedBrush}" />
                    <Run x:Name="MicValue" Text="{x:Static res:Strings.StatusMic}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
