<Window x:Class="Screenrecorder.MiniBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Theme-independent dark look, like the frame's size label -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" Background="#F01E1E1E" CornerRadius="6" Padding="10,3,4,3">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StateGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable, Segoe UI" Margin="0,0,6,0" />
            <Button x:Name="PauseButton" Style="{StaticResource BarButton}" Click="Pause_Click" />
            <Button x:Name="StopButton" Style="{StaticResource BarButton}" Content="&#xE71A;" Click="Stop_Click" />
        </StackPanel>
    </Border>
</Window>
