<Window x:Class="Screenrecorder.RegionFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="CanResize" UseLayoutRounding="True" Width="800" Height="600">
    <!-- Fully transparent pixels are click-through, so only the header and the border react to the mouse. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Height="24" HorizontalAlignment="Left" Padding="8,0"
                Background="#E61E1E1E" CornerRadius="4,4,0,0" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <TextBlock x:Name="SizeText" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Border>
        <Border x:Name="Frame" BorderThickness="4" BorderBrush="#FF2B88D8" />
    </DockPanel>
</Window>
