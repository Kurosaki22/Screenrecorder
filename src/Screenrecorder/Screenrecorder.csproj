<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its implicit usings would clash with WPF names, see below -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Rendered by tools/make-icon.cs -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WPF0001: Fluent ThemeMode is flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Product>Screenrecorder</Product>
    <Copyright>Copyright © 2026. All rights reserved.</Copyright>
    <!-- Checked here, before the SDK defaults Version to 1.0.0; CI passes -p:Version from the tag. -->
    <VersionFromGit Condition="'$(Version)' == ''">true</VersionFromGit>
  </PropertyGroup>

  <!-- Local builds: take the version from the latest git tag (v0.4.2 -> 0.4.2); keeps 1.0.0 without git or tags. -->
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion" Condition="'$(VersionFromGit)' == 'true'">
    <Exec Command="git describe --tags --abbrev=0" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTag" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitExitCode)' == '0'">
      <Version>$(GitTag.TrimStart('v'))</Version>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- Shown under Settings > About; LGPL requires shipping the license texts with the program. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <!-- Release builds: CI drops the LGPL ffmpeg build into ffmpeg\ (gitignored) so the app ships as one exe.
       Without it, Recorder.FindFfmpeg falls back to ffmpeg on PATH. -->
  <ItemGroup>
    <EmbeddedResource Include="ffmpeg\ffmpeg.exe" LogicalName="ffmpeg.exe" Condition="Exists('ffmpeg\ffmpeg.exe')" />
    <EmbeddedResource Include="ffmpeg\FFMPEG-LICENSE.txt" LogicalName="FFMPEG-LICENSE.txt" Condition="Exists('ffmpeg\FFMPEG-LICENSE.txt')" />
    <EmbeddedResource Include="ffmpeg\FFMPEG-VERSION.txt" LogicalName="FFMPEG-VERSION.txt" Condition="Exists('ffmpeg\FFMPEG-VERSION.txt')" />
  </ItemGroup>

</Project>
