<Window x:Class="Screenrecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Screenrecorder.Resources"
        Title="{x:Static res:Strings.Settings}" Width="780" Height="540" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="Categories" SelectionChanged="Categories_SelectionChanged">
            <ListBoxItem Content="{x:Static res:Strings.CategoryRecording}" IsSelected="True" />
            <ListBoxItem Content="{x:Static res:Strings.CategoryHotkeys}" />
            <ListBoxItem Content="{x:Static res:Strings.CategoryOutput}" />
            <ListBoxItem Content="{x:Static res:Strings.CategoryAppearance}" />
            <ListBoxItem Content="{x:Static res:Strings.CategoryInfo}" />
        </ListBox>

        <!-- One page per category; Categories_SelectionChanged shows the matching child. -->
        <Grid x:Name="Pages" Grid.Column="2">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Quality}" Style="{StaticResource Header}" />
                <DockPanel>
                    <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10"
                            TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                            ValueChanged="QualitySlider_ValueChanged" />
                </DockPanel>
                <DockPanel Margin="0,2,48,0">
                    <TextBlock Text="{x:Static res:Strings.QualityBetter}" DockPanel.Dock="Right" Style="{StaticResource Hint}" />
                    <TextBlock Text="{x:Static res:Strings.QualitySmaller}" Style="{StaticResource Hint}" />
                </DockPanel>
                <TextBlock Text="{x:Static res:Strings.QualityHint}" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                <CheckBox x:Name="ShowCursorBox" Content="{x:Static res:Strings.ShowCursor}" Margin="0,28,0,0" />
            </StackPanel>

            <StackPanel Visibility="Collapsed">
                <TextBlock Text="{x:Static res:Strings.CategoryHotkeys}" Style="{StaticResource Header}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:Strings.HotkeyRecordLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="HotkeyRecordBox" Grid.Column="1" Margin="0,4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.HotkeyPauseLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="HotkeyPauseBox" Grid.Row="1" Grid.Column="1" Margin="0,4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.HotkeySelectAreaLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="HotkeySelectAreaBox" Grid.Row="2" Grid.Column="1" Margin="0,4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                </Grid>
                <TextBlock Text="{x:Static res:Strings.HotkeyHelp}" Style="{StaticResource Hint}" Margin="0,16,0,0" />
            </StackPanel>

            <StackPanel Visibility="Collapsed">
                <TextBlock Text="{x:Static res:Strings.OutputFolder}" Margin="0,0,0,4" />
                <DockPanel>
                    <Button Content="…" DockPanel.Dock="Right" Width="44" Margin="8,0,0,0" Click="BrowseFolder_Click" />
                    <TextBox x:Name="OutputFolderBox" />
                </DockPanel>
                <TextBlock Text="{x:Static res:Strings.FileName}" Margin="0,16,0,4" />
                <DockPanel>
                    <Button x:Name="TokenButton" Content="…" DockPanel.Dock="Right" Width="44" Margin="8,0,0,0" Click="Tokens_Click" />
                    <TextBox x:Name="FileNameBox" TextChanged="FileName_Changed" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="{x:Static res:Strings.StartNumber}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="StartNumberBox" Width="100" TextChanged="FileName_Changed" />
                </StackPanel>
                <TextBlock x:Name="FileNamePreview" Margin="0,16,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Visibility="Collapsed">
                <TextBlock Text="{x:Static res:Strings.Language}" Style="{StaticResource Header}" />
                <ComboBox x:Name="LanguageBox" Width="240" HorizontalAlignment="Left" />
                <TextBlock Text="{x:Static res:Strings.RestartHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <TextBlock Text="{x:Static res:Strings.Theme}" Style="{StaticResource Header}" Margin="0,28,0,8" />
                <RadioButton x:Name="ThemeSystem" Content="{x:Static res:Strings.LanguageSystem}" GroupName="Theme" />
                <RadioButton x:Name="ThemeLight" Content="{x:Static res:Strings.ThemeLight}" GroupName="Theme" />
                <RadioButton x:Name="ThemeDark" Content="{x:Static res:Strings.ThemeDark}" GroupName="Theme" />
            </StackPanel>

            <DockPanel Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="Screenrecorder" Style="{StaticResource Header}" />
                <TextBlock x:Name="VersionText" DockPanel.Dock="Top" />
                <TextBlock x:Name="FfmpegText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,12" />
                <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Reset}" MinWidth="120" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Ok}" MinWidth="100" IsDefault="True" Click="Ok_Click" />
                <Button Content="{x:Static res:Strings.Cancel}" MinWidth="100" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
