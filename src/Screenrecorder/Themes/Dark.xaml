<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette: same keys as the other theme file, swapped by App.ApplyTheme -->
    <SolidColorBrush x:Key="GroundBrush" Color="#141416" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1D1D20" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#26262B" />
    <SolidColorBrush x:Key="SurfaceLowBrush" Color="#101012" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#2B2B30" />
    <Color x:Key="InkColor">#ECECEF</Color>
    <SolidColorBrush x:Key="InkBrush" Color="#ECECEF" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#8E8E96" />
    <SolidColorBrush x:Key="OnInkBrush" Color="#141416" />
    <SolidColorBrush x:Key="RecordBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="RecordTextBrush" Color="#FF6B6F" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E8A93A" />
    <SolidColorBrush x:Key="HoverWashBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PressWashBrush" Color="#33FFFFFF" />
</ResourceDictionary>
